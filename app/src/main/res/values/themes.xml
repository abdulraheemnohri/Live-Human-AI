<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 Light Theme -->
    <style name="Theme.LiveHumanAI" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/md_ref_pal_primary</item>
        <item name="colorPrimaryContainer">@color/md_ref_pal_primary_container</item>
        <item name="colorOnPrimary">@color/md_ref_pal_on_primary</item>
