        <item name="colorSurfaceContainer">@color/md_ref_pal_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_ref_pal_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_ref_pal_surface_container_highest</item>
        <item name="colorSurfaceContainerLow">@color/md_ref_pal_surface_container_low</item>
        <item name="colorSurfaceContainerLower">@color/md_ref_pal_surface_container_lower</item>
        <item name="colorSurfaceContainerLowest">@color/md_ref_pal_surface_container_lowest</item>

